{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "exclude": [
    "src/sync/webdav.e2e.test.ts",
    "src/theme.test.ts",
    "src/designLedger.test.ts",
    "src/themeMotion.test.ts",
    "src/components/dialogA11y.test.ts",
    "src/themeContrast.test.ts",
    "src/themeTypography.test.ts"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
