{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BlockHabit",
  "version": "0.2.2",
  "identifier": "com.blockhabit.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BlockHabit",
        "width": 1100,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false
      },
      {
        "label": "tray-menu",
        "title": "",
        "width": 240,
        "height": 172,
        "resizable": false,
        "decorations": false,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "transparent": true,
        "shadow": false,
        "focus": false,
        "backgroundColor": "#00000000"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https: wss: ipc: http://ipc.localhost; frame-ancestors 'none'",
      "devCsp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU5RUQwM0QyOEI3OThGQzMKUldURGozbUwwZ1B0V1RkeWpxM2NHSkJFMGhhUzhKZUhhL08ramc4VTNOS2JzaXJSR3BYaDJwV3gK",
      "endpoints": [
        "https://github.com/LeeeeCm/BlockHabit/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
