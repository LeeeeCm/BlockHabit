{
  "name": "blockhabit",
  "private": true,
  "version": "0.2.2",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "design:check": "node scripts/design-ledger.mjs",
    "design:fix": "node scripts/design-ledger.mjs --fix",
    "check:versions": "node scripts/check-versions.mjs",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\" .prettierrc.json vite.config.ts index.html package.json tsconfig.json tsconfig.node.json",
    "format": "prettier --write .",
    "release:check": "node scripts/check-release.mjs"
  },
  "dependencies": {
    "@fontpkg/alimama-fang-yuan-ti-vf": "^1.0.5",
    "@fontpkg/alimama-shu-hei-ti": "^1.0.5",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@fontsource/rubik": "^5.3.0",
    "@fontsource/zcool-qingke-huangyou": "^5.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-http": "^2.9.0",
    "@tauri-apps/plugin-notification": "^2.8.1",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "misans": "^4.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.6.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.10.0",
    "sharp": "^0.35.5",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.11"
  }
}
